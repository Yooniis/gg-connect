# Kopiera till .env.local för lokal utveckling

ADMIN_PIN=1234

# Firebase Storage-bucket, t.ex. your-project.appspot.com eller your-project.firebasestorage.app
FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_PROJECT_ID.firebasestorage.app

# Lokal utveckling: klistra in service account JSON som en rad
# (Firebase Console → Project settings → Service accounts → Generate new private key)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
