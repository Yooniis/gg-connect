{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules",
    "bucket": "gg-connect-db18a-parkaden"
  },
  "hosting": [
    {
      "target": "parkaden",
      "public": "public-hosting",
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**"
      ],
      "rewrites": [
        {
          "source": "**",
          "run": {
            "serviceId": "parkaden-quest",
            "region": "europe-west4"
          }
        }
      ]
    }
  ],
  "apphosting": [
    {
      "backendId": "parkaden-quest",
      "rootDir": ".",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        ".next",
        "dist",
        ".wrangler",
        ".sites-runtime",
        "service-account.json",
        ".env.local",
        ".env*"
      ]
    }
  ]
}
